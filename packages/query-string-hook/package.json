{
  "name": "@motech-development/query-string-hook",
  "version": "0.0.0-development",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/motech-development/platform.git"
  },
  "description": "A hook to access query strings",
  "author": "Mo Gusbi <mo.gusbi@motechdevelopment.co.uk> (https://motechdevelopment.co.uk)",
  "bugs": {
    "url": "https://github.com/motech-development/platform/issues"
  },
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "scripts": {
    "formatting": "prettier . --check",
    "build": "run prebuild && vite build && tsc --project tsconfig.build.json --emitDeclarationOnly",
    "lint": "eslint './src/**/*.{ts,tsx}'",
    "package": "run build",
    "prebuild": "rimraf ./lib",
    "test": "vitest --no-file-parallelism",
    "test-ci": "vitest run --coverage --no-file-parallelism",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "qs": "6.14.0"
  },
  "devDependencies": {
    "@motech-development/eslint-config-motech-react": "workspace:*",
    "@motech-development/prettier-motech-config": "workspace:*",
    "@motech-development/semantic-release": "workspace:*",
    "@testing-library/react": "16.2.0",
    "@types/qs": "6.9.18",
    "@types/react": "18.3.18",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "9.37.0",
    "jsdom": "29.1.1",
    "prettier": "3.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.3",
    "rimraf": "6.0.1",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.9"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.3"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write",
    "src/**/*.{ts,tsx}": "eslint --fix"
  }
}
