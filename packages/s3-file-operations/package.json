{
  "name": "@motech-development/s3-file-operations",
  "version": "0.0.0-development",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/motech-development/platform.git"
  },
  "description": "A wrapper utility to manage file operations on AWS S3",
  "author": "Mo Gusbi <mo.gusbi@motechdevelopment.co.uk> (https://motechdevelopment.co.uk)",
  "bugs": {
    "url": "https://github.com/motech-development/platform/issues"
  },
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib"
  ],
  "main": "lib/s3-file-operations.cjs.js",
  "module": "lib/s3-file-operations.esm.js",
  "types": "lib/s3-file-operations.d.ts",
  "scripts": {
    "formatting": "prettier . --check",
    "build": "run prebuild && vite build && tsc --project tsconfig.build.json --emitDeclarationOnly",
    "lint": "eslint './src/**/*.ts'",
    "package": "run build",
    "prebuild": "rimraf ./lib",
    "test": "vitest --no-file-parallelism",
    "test-ci": "vitest run --coverage --no-file-parallelism",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1033.0",
    "@aws-sdk/client-s3": "3.1033.0",
    "@aws-sdk/lib-dynamodb": "3.1033.0",
    "@aws-sdk/lib-storage": "3.1033.0",
    "@aws-sdk/s3-request-presigner": "3.1033.0"
  },
  "devDependencies": {
    "@aws-sdk/util-stream-node": "3.374.0",
    "@motech-development/eslint-config-motech-base": "workspace:*",
    "@motech-development/prettier-motech-config": "workspace:*",
    "@motech-development/semantic-release": "workspace:*",
    "@smithy/types": "4.14.1",
    "@vitest/coverage-v8": "4.1.9",
    "aws-sdk-client-mock": "4.1.0",
    "aws-sdk-client-mock-vitest": "7.1.0",
    "eslint": "9.37.0",
    "prettier": "3.2.5",
    "rimraf": "6.0.1",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.9"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write",
    "src/**/*.{ts,tsx}": "eslint --fix"
  }
}
