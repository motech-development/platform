{
  "name": "@accounts/data-restore",
  "version": "0.1.0",
  "bin": "bin/infrastructure.js",
  "scripts": {
    "formatting": "prettier . --check",
    "build": "tsc",
    "cdk": "cdk",
    "deploy": "cdk deploy --all",
    "lint": "eslint './**/*.{js,jsx,ts,tsx}'",
    "teardown": "cdk destroy --all",
    "test": "vitest --no-file-parallelism",
    "test-ci": "vitest run --coverage --no-file-parallelism",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1033.0",
    "@aws-sdk/util-dynamodb": "3.996.2",
    "@motech-development/node-logger": "workspace:*",
    "aws-cdk-lib": "2.189.1",
    "constructs": "10.4.2"
  },
  "devDependencies": {
    "@motech-development/eslint-config-motech-base": "workspace:*",
    "@motech-development/prettier-motech-config": "workspace:*",
    "@motech-development/semantic-release": "workspace:*",
    "@smithy/types": "4.14.1",
    "@swc/core": "1.11.5",
    "@swc/helpers": "0.5.15",
    "@types/aws-lambda": "8.10.147",
    "@vitest/coverage-v8": "4.1.9",
    "aws-cdk": "2.1001.0",
    "aws-lambda-mock-context": "3.2.1",
    "aws-sdk-client-mock": "4.1.0",
    "aws-sdk-client-mock-vitest": "7.1.0",
    "esbuild": "0.25.0",
    "eslint": "9.37.0",
    "prettier": "3.2.5",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write",
    "src/**/*.{ts,tsx}": "eslint --fix"
  }
}
