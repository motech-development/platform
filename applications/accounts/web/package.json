{
  "name": "@accounts/web",
  "version": "0.0.0-development",
  "description": "Production-shaped replacement Accounts web application",
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "type": "module",
  "scripts": {
    "build": "vite build && node --import tsx scripts/build-service-worker.ts",
    "cdk": "cdk",
    "codegen.graphql": "graphql-codegen",
    "deploy": "tsx infrastructure/deploy.ts",
    "e2e": "playwright test --ui",
    "e2e-ci": "playwright test",
    "formatting": "prettier . --check",
    "lint": "eslint .",
    "reconcile": "cdk deploy accounts-web-hosting --require-approval never",
    "serve": "vite preview",
    "start": "vite",
    "teardown": "tsx infrastructure/teardown.ts",
    "test": "vitest --no-file-parallelism",
    "test-ci": "vitest run --coverage --no-file-parallelism",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apollo/client": "4.2.7",
    "@apollo/client-integration-tanstack-start": "0.14.5-rc.0",
    "@auth0/auth0-react": "2.22.0",
    "@motech-development/breeze-ui": "workspace:*",
    "@sentry/tanstackstart-react": "10.66.0",
    "@tanstack/react-form": "1.33.2",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.32",
    "@tanstack/router-core": "1.171.15",
    "aws-appsync-auth-link": "4.0.2",
    "aws-appsync-subscription-link": "4.0.3",
    "aws-cdk-lib": "2.261.0",
    "buffer": "6.0.3",
    "constructs": "10.7.0",
    "decimal.js": "10.6.0",
    "file-saver": "2.0.5",
    "graphql": "16.14.2",
    "i18next": "23.16.8",
    "i18next-resources-to-backend": "1.2.1",
    "pdfjs-dist": "5.4.296",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "13.5.0",
    "react-pdf": "10.4.1",
    "rxjs": "7.8.2",
    "uuid": "10.0.0",
    "vite": "8.1.5",
    "workbox-build": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@graphql-codegen/cli": "7.2.0",
    "@graphql-codegen/client-preset": "6.1.0",
    "@motech-development/eslint-config-motech-react": "workspace:*",
    "@motech-development/prettier-motech-config": "workspace:*",
    "@motech-development/semantic-release": "workspace:*",
    "@parcel/watcher": "2.5.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.3.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/file-saver": "2.0.7",
    "@types/node": "24.8.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.9",
    "aws-cdk": "2.1132.0",
    "eslint": "9.37.0",
    "jsdom": "29.1.1",
    "prettier": "3.2.5",
    "tailwindcss": "4.3.2",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.9"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write",
    "src/**/*.{ts,tsx}": "eslint --fix"
  }
}
