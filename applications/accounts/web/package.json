{
  "name": "@accounts/web",
  "version": "0.0.0-development",
  "private": true,
  "description": "Accounts placeholder with retained Amplify hosting",
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "type": "module",
  "scripts": {
    "build": "vite build",
    "cdk": "cdk",
    "deploy": "tsx infrastructure/deploy.ts",
    "formatting": "prettier . --check",
    "lint": "eslint .",
    "reconcile": "cdk deploy accounts-web-hosting --require-approval never",
    "serve": "vite preview",
    "start": "vite",
    "teardown": "tsx infrastructure/teardown.ts",
    "test": "vitest",
    "test-ci": "vitest run --coverage --no-file-parallelism",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "aws-cdk-lib": "2.261.0",
    "constructs": "10.7.0"
  },
  "devDependencies": {
    "@motech-development/eslint-config-motech-base": "workspace:*",
    "@motech-development/prettier-motech-config": "workspace:*",
    "@motech-development/semantic-release": "workspace:*",
    "@types/node": "24.8.1",
    "@vitest/coverage-v8": "4.1.9",
    "aws-cdk": "2.1132.0",
    "eslint": "9.37.0",
    "prettier": "3.2.5",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.9"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write",
    "**/*.ts": "eslint --fix"
  }
}
