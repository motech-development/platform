#if($ctx.error)
  $util.appendError($ctx.error.message, $ctx.error.type, null, $ctx.result.cancellationReasons)
#end

#set($owner = ${ownerId})

#if($owner == $ctx.arguments.id)
  #set($ids = $ctx.args.input.ids)
  #set($items = [])

  #foreach($id in $ids)
    $util.qr($items.add({
      "id": "$id",
      "read": true
    }))
  #end

  {
    "id": $util.toJson($owner),
    "items": $util.toJson($items)
  }
#else
  null
#end
