#set($endpoint = "/${stage}/api/v1/signed-download")
#set($owner = ${ownerId})

{
  "version": "2018-05-29",
  "method": "POST",
  "resourcePath": "$endpoint",
  "params": {
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "owner": $util.toJson($owner),
      "path": $util.toJson($ctx.args.path)
    }
  }
}
