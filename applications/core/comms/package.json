{
  "name": "@core/comms",
  "version": "0.0.0-development",
  "description": "Motech Development comms infrastructure",
  "scripts": {
    "formatting": "prettier . --check",
    "deploy": "serverless deploy --verbose",
    "lint": "eslint './src/**/*.ts'",
    "teardown": "serverless remove --verbose",
    "test": "vitest --no-file-parallelism",
    "test-ci": "vitest run --coverage --no-file-parallelism",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "3.1033.0",
    "@sentry/aws-serverless": "10.48.0",
    "@sentry/profiling-node": "10.48.0",
    "cfn-response-async": "1.0.0",
    "yup": "1.4.0"
  },
  "devDependencies": {
    "@motech-development/eslint-config-motech-base": "workspace:*",
    "@motech-development/prettier-motech-config": "workspace:*",
    "@motech-development/semantic-release": "workspace:*",
    "@smithy/types": "4.14.1",
    "@swc/core": "1.11.5",
    "@types/aws-lambda": "8.10.147",
    "@vitest/coverage-v8": "4.1.9",
    "aws-lambda-mock-context": "3.2.1",
    "aws-sdk-client-mock": "4.1.0",
    "aws-sdk-client-mock-vitest": "7.1.0",
    "eslint": "9.37.0",
    "osls": "3.63.2",
    "prettier": "3.2.5",
    "serverless-deployment-bucket": "1.6.0",
    "serverless-prune-plugin": "2.1.0",
    "serverless-webpack": "5.15.4",
    "swc-loader": "0.2.7",
    "typescript": "6.0.3",
    "vitest": "4.1.9",
    "webpack": "5.106.2",
    "webpack-node-externals": "3.0.0"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write",
    "src/**/*.{ts,tsx}": "eslint --fix"
  }
}
